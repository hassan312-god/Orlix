{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@orlix/types": ["packages/types/src/index.ts"],
      "@orlix/types/*": ["packages/types/src/*"],
      "@orlix/utils": ["packages/utils/src/index.ts"],
      "@orlix/utils/*": ["packages/utils/src/*"],
      "@orlix/ui": ["packages/ui/src/index.ts"],
      "@orlix/ui/*": ["packages/ui/src/*"],
      "@orlix/nexus": ["packages/nexus/src/index.ts"],
      "@orlix/nexus/*": ["packages/nexus/src/*"]
    }
  }
}
